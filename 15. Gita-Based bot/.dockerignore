# Docker ignore file for Gita chatbot

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Virtual environments
venv/
env/
ENV/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
*.md

# Development files
.env
.env.local
.env.development
.env.test
.env.production

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Node modules (if any)
node_modules/

# Docker files (don't include in build context)
Dockerfile*
docker-compose*.yml
.dockerignore

# Large files that should be mounted as volumes
# Note: vector_store.faiss/ is mounted as volume, not copied
# *.pdf files are also mounted as volumes

# Cache directories
.cache/
.pytest_cache/
