# Dockerfile.streamlit
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    langchain \
    langchain-community \
    langchain-ollama \
    faiss-cpu \
    flashrank \
    pydantic \
    typing_extensions \
    pypdf \
    streamlit

# Copy application files
COPY run_bot_streamlit.py /app/
COPY bhagavad-gita-in-english-source-file.pdf /app/

# Create data directory for shared FAISS index
RUN mkdir -p /data

# Set environment variables
ENV OLLAMA_LLM_BASE_URL=http://ollama-llm:11434
ENV OLLAMA_EMBED_BASE_URL=http://ollama-embed:11434
ENV FAISS_INDEX_PATH=/data/vector_store.faiss

# Expose Streamlit port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run Streamlit
CMD ["streamlit", "run", "run_bot_streamlit.py", "--server.port=8501", "--server.address=0.0.0.0"]